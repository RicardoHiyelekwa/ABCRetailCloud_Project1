@model IEnumerable<ABCRetailCloud.Models.Customer>

<h2>Customers</h2>

<a class="btn btn-primary mb-3" asp-action="Create">
    Add Customer
</a>

<a asp-action="GenerateDemo" class="btn btn-warning mb-3">
    Generate Demo Data
</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Email</td>
                <td>

                    <a class="btn btn-warning btn-sm"
                       asp-action="Edit"
                       asp-route-id="@c.RowKey">
                        Edit
                    </a>

                    <button class="btn btn-danger btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#deleteCustomerModal"
                            data-id="@c.RowKey">
                        Delete
                    </button>

                </td>
            </tr>
        }
    </tbody>
</table>

<!-- DELETE MODAL -->

<div class="modal fade" id="deleteCustomerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                Are you sure you want to delete this customer?
            </div>

            <div class="modal-footer">

                <form asp-action="Delete" method="post">
                    <input type="hidden" id="deleteCustomerId" name="id" />
                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>
                </form>

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

            </div>

        </div>
    </div>
</div>

<script>
    var deleteCustomerModal = document.getElementById('deleteCustomerModal');

    deleteCustomerModal.addEventListener('show.bs.modal', function (event) {

        var button = event.relatedTarget;
        var id = button.getAttribute('data-id');

        document.getElementById("deleteCustomerId").value = id;

    });
</script>